# Copia este archivo a ".env" y completa tus valores reales.
# ".env" NO se sube a git (ver .gitignore).

# --- Base de datos ---
# Si no defines DATABASE_URL, el proyecto usa SQLite automáticamente (gym.db)
# para que puedas arrancar sin instalar Postgres.
# Para usar PostgreSQL (recomendado, y para lo que corre con docker-compose):
 DATABASE_URL=postgresql+psycopg://gym_user:gym_pass@localhost:5432/gym_db

# --- Seguridad ---
# Clave secreta para firmar las cookies de sesión. Cambiala en producción.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
